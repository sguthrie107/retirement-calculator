# -------------------------------------------------------
# Local development: SQLite (default, no changes needed)
# -------------------------------------------------------
DATABASE_URL=sqlite:///retirement.db

# -------------------------------------------------------
# Production (Railway): paste your Railway Postgres URL
# e.g. postgresql://postgres:password@host.railway.internal:5432/railway
# -------------------------------------------------------
# DATABASE_URL=postgresql://...

# Security (CHANGE IN PRODUCTION — use a long random string)
SECRET_KEY=change-me-in-production

# HTTP Basic Auth passwords — set these for each user.
# Leaving a password blank disables that account entirely.
AUTH_STEVEN_PASSWORD=
AUTH_ALYSSA_PASSWORD=
AUTH_GUEST_PASSWORD=

# Failed-login hardening
# Lock IP after this many failed attempts within AUTH_FAILED_WINDOW_SECONDS.
AUTH_MAX_FAILED_ATTEMPTS=8
# Rolling time window (seconds) for counting failed auth attempts.
AUTH_FAILED_WINDOW_SECONDS=300
# Lockout duration (seconds) once threshold is reached.
AUTH_LOCKOUT_SECONDS=900

# Debug mode (set false in production)
DEBUG=false

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8000
